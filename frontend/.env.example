# ==========================================
# Izwan Frontend - Variables d'environnement
# ==========================================
# Copie ce fichier en ".env" et remplis les valeurs réelles.
# Le fichier ".env" est ignoré par Git (ne le commit PAS).
# Toutes les variables publiques doivent commencer par "VITE_".

# --- API Backend ---
# URL de l'API backend. Décommente et ajuste si nécessaire.
VITE_API_URL=http://localhost:8000/api/v1

# --- Mode développement ---
# Définir à 'true' pour activer les logs de debug
# VITE_DEBUG_MODE=true
