{
  "name": "izwan-vscode",
  "publisher": "kodek10",
  "displayName": "Izwan - Snippet Manager IA",
  "description": "Accédez à vos snippets Izwan directement depuis votre éditeur.",
  "version": "0.0.4",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kodek-10/Izwan.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:izwan-snippets-view",
    "onCommand:izwan.saveSnippet",
    "onCommand:izwan.login",
    "onUri"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "izwan-explorer",
          "title": "Izwan",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "izwan-explorer": [
        {
          "id": "izwan-snippets-view",
          "type": "webview",
          "name": "%izwan.view.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "izwan.searchSnippet",
        "title": "%izwan.searchSnippet.title%"
      },
      {
        "command": "izwan.saveSnippet",
        "title": "%izwan.saveSnippet.title%"
      },
      {
        "command": "izwan.refreshSnippets",
        "title": "%izwan.refreshSnippets.title%"
      },
      {
        "command": "izwan.login",
        "title": "%izwan.login.title%"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "izwan.saveSnippet",
          "when": "editorHasSelection",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Izwan",
      "properties": {
        "izwan.backendUrl": {
          "type": "string",
          "default": "http://localhost:8000/api/v1",
          "description": "%izwan.configuration.backendUrl.description%"
        },
        "izwan.frontendUrl": {
          "type": "string",
          "default": "https://izwan.pages.dev/auth",
          "description": "%izwan.configuration.frontendUrl.description%"
        },
        "izwan.ghostSnippets.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%izwan.configuration.ghostSnippets.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "@vscode/test-electron": "^3.1.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "marked": "^18.0.7",
    "prismjs": "^1.30.0"
  }
}
