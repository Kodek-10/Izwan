# ==========================================
# Izwan Backend - Variables d'environnement
# ==========================================
# 1. Copie ce fichier en ".env" et remplis les valeurs réelles.
# 2. Le fichier ".env" est ignoré par Git (ne le commit JAMAIS).
# 3. Remplace les placeholders ci-dessous par tes vraies valeurs.
#
# ⚠️ IMPORTANT PRODUCTION : utilise des secrets forts et uniques.
#
# ==========================================

# --- Base de données ---
# Par défaut: SQLite local (développement uniquement)
# Pour PostgreSQL (Supabase, AWS, etc.), utilise un format comme :
# DATABASE_URL=postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///./snippets.db

# --- Sécurité / JWT ---
# Clé secrète pour signer les tokens JWT (OBLIGATOIRE en production).
# Génère une clé forte : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=changez-moi-une-cle-super-secrete-et-longue

# --- CORS ---
# Origines autorisées pour les requêtes frontend (séparées par virgule)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# --- IA / Groq (Recommandé) ---
# Clé API Groq (obtenue sur https://console.groq.com/keys)
GROQ_API_KEY=gsk_votre_cle_groq_ici

# Modèle par défaut pour Groq (optionnel)
GROQ_MODEL_NAME=llama-3.1-8b-instant

# Modèle long contexte pour Groq (optionnel)
GROQ_LONG_CONTEXT_MODEL=llama-3.1-8b-instant

# --- IA / Ollama (Local, sans connexion internet) ---
# URL de l'instance Ollama locale (optionnel, utiliser par défaut si Groq non configuré)
OLLAMA_BASE_URL=http://localhost:11434

# Taille du contexte pour Ollama (optionnel)
# OLLAMA_CONTEXT_WINDOW=4096
