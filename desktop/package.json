{
  "name": "izwan-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Izwan desktop — coquille native qui charge l'application web hébergée (V2).",
  "main": "src/main.cjs",
  "scripts": {
    "dev": "electron .",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "check": "node --check src/main.cjs"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.kodek10.izwan",
    "productName": "Izwan",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Kodek-10",
        "repo": "Izwan"
      }
    ],
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Development",
      "maintainer": "Izwan <contact@izwan.app>"
    }
  }
}
