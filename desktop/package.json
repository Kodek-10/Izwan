{
  "name": "izwan-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Izwan desktop shell with local backend orchestration.",
  "main": "src/main.cjs",
  "scripts": {
    "dev": "electron .",
    "build:frontend": "npm --prefix ../frontend run build",
    "build:backend:win": "python -m PyInstaller ../backend/pyinstaller/izwan-backend.spec --noconfirm --distpath ../backend/dist --workpath ../backend/build",
    "build:backend:unix": "pyinstaller ../backend/pyinstaller/izwan-backend.spec --noconfirm --distpath ../backend/dist --workpath ../backend/build",
    "dist:win": "npm run build:frontend && electron-builder --win",
    "dist:mac": "npm run build:frontend && electron-builder --mac",
    "dist:linux": "npm run build:frontend && electron-builder --linux",
    "check": "node --check src/main.cjs && node --check src/preload.cjs"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.kodek10.izwan",
    "productName": "Izwan",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "frontend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../backend/dist",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
